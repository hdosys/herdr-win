+    #[test]
+    fn windows_bridge_download_retries_backpressure() {
+        let socket = local_forward_socket_path("download-backpressure-test", "default");
+        crate::ipc::prepare_socket_path(&socket, |_| "busy".to_string()).unwrap();
+        let listener = crate::ipc::bind_local_listener(&socket).unwrap();
+        let identity = crate::ipc::socket_file_identity(&socket).unwrap();
+        let mut client = crate::ipc::connect_local_stream(&socket).unwrap();
+        let mut server = listener.accept().unwrap();
+        crate::ipc::set_local_stream_nonblocking(&mut server, true).unwrap();
+
+        let payload = vec![0x5a; 256 * 1024];
+        let expected_len = payload.len();
+        let bridge_stop = Arc::new(AtomicBool::new(false));
+        let copy_bridge_stop = Arc::clone(&bridge_stop);
+        let (result_tx, result_rx) = std::sync::mpsc::channel();
+        let copy = thread::spawn(move || {
+            let mut input = io::Cursor::new(payload);
+            result_tx
+                .send(copy_reader_to_local_stream(
+                    &mut input,
+                    &mut server,
+                    &copy_bridge_stop,
+                ))
+                .unwrap();
+        });
+
+        thread::sleep(Duration::from_millis(100));
+        let deadline = Instant::now() + Duration::from_secs(2);
+        let mut received = Vec::with_capacity(expected_len);
+        let mut buffer = [0_u8; 16 * 1024];
+        while received.len() < expected_len && Instant::now() < deadline {
+            match crate::ipc::poll_local_stream_read_count(&mut client, &mut buffer).unwrap() {
+                crate::ipc::LocalStreamReadCount::Data(read) => {
+                    received.extend_from_slice(&buffer[..read]);
+                }
+                crate::ipc::LocalStreamReadCount::Pending => thread::sleep(BRIDGE_IO_POLL),
+                crate::ipc::LocalStreamReadCount::Closed => {
+                    panic!("bridge closed under backpressure")
+                }
+            }
+        }
+
+        assert_eq!(received.len(), expected_len);
+        assert!(received.iter().all(|byte| *byte == 0x5a));
+        assert_eq!(
+            result_rx
+                .recv_timeout(Duration::from_secs(1))
+                .unwrap()
+                .unwrap(),
+            expected_len as u64
+        );
+        copy.join().unwrap();
+
+        drop(client);
+        drop(listener);
+        crate::ipc::remove_socket_file_if_owned(&socket, &identity).unwrap();
+    }
