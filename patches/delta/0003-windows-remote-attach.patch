+impl Drop for RemoteSsh {
+    fn drop(&mut self) {
+        let Some(_control_path) = self
+            .managed_config
+            .as_ref()
+            .and_then(|config| config.options.control_path.as_ref())
+        else {
+            return;
+        };
+
+        let _ = self
+            .base_command()
+            .arg("-O")
+            .arg("exit")
+            .arg("-o")
+            .arg("BatchMode=yes")
+            .arg(&self.target)
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .status();
+    }
+}
