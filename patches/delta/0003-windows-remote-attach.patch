+        assert!(bootstrap.contains("[IO.Directory]::Move($stage, $Destination)"));
+        assert!(bootstrap.contains("[IO.Directory]::Move($backup, $Destination)"));
+        assert!(bootstrap.contains("[IO.File]::Delete($Archive)"));
+        assert!(bootstrap.contains("FileShare]::None"));
+        assert!(commit.encode_utf16().count() < 32_767);
+    }
