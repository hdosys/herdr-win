+    #[test]
+    fn windows_local_payload_packager_projects_only_portable_files() {
+        let root = std::env::temp_dir().join(format!(
+            "herdr-local-windows-packager-test-{}",
+            std::process::id()
+        ));
+        let _ = fs::remove_dir_all(&root);
+        let source = root.join("source");
+        let stage = root.join("stage");
+        let archive = root.join("payload.zip");
+        fs::create_dir_all(&source).unwrap();
+        fs::write(source.join("herdr.exe"), b"herdr").unwrap();
+
+        for relative in WINDOWS_PORTABLE_RUNTIME_REQUIRED_FILES {
+            let path = relative
+                .split('/')
+                .fold(source.clone(), |path, component| path.join(component));
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            fs::write(path, format!("payload:{relative}")).unwrap();
+        }
+        let conpty_files = [
+            "conpty/conpty.dll",
+            "conpty/x64/OpenConsole.exe",
+            "conpty/arm64/OpenConsole.exe",
+        ];
+        let hashes = conpty_files
+            .iter()
+            .map(|relative| {
+                let path = relative
+                    .split('/')
+                    .fold(source.clone(), |path, component| path.join(component));
+                ((*relative).to_string(), file_sha256(&path).unwrap())
+            })
+            .collect::<std::collections::BTreeMap<_, _>>();
+        fs::write(
+            source.join("conpty").join("herdr-conpty.json"),
+            serde_json::to_vec_pretty(&serde_json::json!({
+                "schema_version": 1,
+                "package": "Microsoft.Windows.Console.ConPTY",
+                "version": "test",
+                "architecture": "x86_64",
+                "files": hashes,
+            }))
+            .unwrap(),
+        )
+        .unwrap();
+        fs::write(source.join("runtime.manifest"), b"installer-only").unwrap();
+        fs::write(source.join("runtime.ready"), b"installer-only").unwrap();
+
+        run_local_windows_payload_packager(&source, &stage, &archive).unwrap();
+        assert!(archive.is_file());
+        assert!(fs::read(&archive).unwrap().starts_with(b"PK"));
+        assert!(!stage.join("runtime.manifest").exists());
+        assert!(!stage.join("runtime.ready").exists());
+        for relative in WINDOWS_PORTABLE_RUNTIME_REQUIRED_FILES {
+            let path = relative
+                .split('/')
+                .fold(stage.clone(), |path, component| path.join(component));
+            assert!(path.is_file(), "missing packaged file {relative}");
+        }
+
+        let _ = fs::remove_dir_all(root);
+    }
