+fn remote_client_binary(ssh: &RemoteSsh, remote_herdr: &RemoteHerdr) -> io::Result<String> {
+    let output = remote_herdr_output(ssh, remote_herdr, &["status", "client", "--json"])?;
+    if !output.status.success() {
