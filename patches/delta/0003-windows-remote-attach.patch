+fn validate_remote_config(ssh: &RemoteSsh, remote_herdr: &RemoteHerdr) -> io::Result<()> {
+    let output = remote_herdr_output(ssh, remote_herdr, &["config", "check"])?;
+    if output.status.success() {
+        Ok(())
+    } else {
+        Err(command_failed(
+            "remote Herdr configuration is invalid",
+            &output,
+        ))
+    }
+}
