+    #[tokio::test]
+    async fn new_session_agent_auto_start_reuses_managed_launch_once() {
+        let (_api_tx, api_rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut app = super::super::App::new(
+            &crate::config::Config::default(),
+            true,
+            None,
+            api_rx,
+            crate::api::EventHub::default(),
+        );
+        let workspace = crate::workspace::Workspace::test_new("auto-start");
+        let root_pane = workspace.tabs[0].root_pane;
+        app.state.workspaces = vec![workspace];
+        app.state.ensure_test_terminals();
+        app.state.active = Some(0);
+        let terminal_id = app.state.workspaces[0].tabs[0].panes[&root_pane]
+            .attached_terminal_id
+            .clone();
+        let (runtime, mut receiver) = crate::terminal::TerminalRuntime::test_with_channel(80, 24);
+        app.terminal_runtimes.insert(terminal_id.clone(), runtime);
+        app.pending_session_auto_start_agent = Some(
+            super::super::PendingSessionAutoStartAgent::AwaitingWorkspace(
+                crate::detect::Agent::OpenCode,
+            ),
+        );
+
+        app.queue_session_auto_start_agent(0);
+
+        assert!(!app.try_start_session_auto_start_agent(Instant::now()));
+        assert!(app.pending_session_auto_start_agent.is_some());
+        assert!(receiver.try_recv().is_err());
+
+        app.terminal_runtimes
+            .get(&terminal_id)
+            .unwrap()
+            .test_process_pty_bytes(b"$ ");
+        assert!(app.try_start_session_auto_start_agent(Instant::now()));
+        assert!(app.pending_session_auto_start_agent.is_none());
+        assert_eq!(
+            app.state.terminals[&terminal_id].agent_name.as_deref(),
+            Some("opencode")
+        );
+        receiver
+            .try_recv()
+            .expect("managed launch should submit the configured agent command");
+
+        assert!(!app.try_start_session_auto_start_agent(Instant::now()));
+        assert!(receiver.try_recv().is_err());
+    }
 }
