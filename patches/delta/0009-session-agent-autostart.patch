+    pub(super) fn queue_session_auto_start_agent(&mut self, ws_idx: usize) {
+        let Some(pending) = self.pending_session_auto_start_agent.take() else {
+            return;
+        };
+        let PendingSessionAutoStartAgent::AwaitingWorkspace(kind) = pending else {
+            self.pending_session_auto_start_agent = Some(pending);
+            return;
+        };
+        let label = crate::detect::agent_label(kind);
+        let Some(root_pane) = self
+            .state
+            .workspaces
+            .get(ws_idx)
+            .and_then(|workspace| workspace.tabs.first())
+            .map(|tab| tab.root_pane)
+        else {
+            tracing::warn!(
+                agent = label,
+                "new session has no initial pane for agent auto-start"
+            );
+            return;
+        };
+        let Some(pane_id) = self.public_pane_id(ws_idx, root_pane) else {
+            tracing::warn!(
+                agent = label,
+                "new session initial pane has no public id for agent auto-start"
+            );
+            return;
+        };
+        self.pending_session_auto_start_agent = Some(PendingSessionAutoStartAgent::AwaitingShell {
+            kind,
+            pane_id,
+            deadline: Instant::now() + DEFAULT_AGENT_START_TIMEOUT,
+        });
+        self.try_start_session_auto_start_agent(Instant::now());
+    }
+
+    pub(crate) fn session_auto_start_deadline(&self) -> Option<Instant> {
+        match self.pending_session_auto_start_agent.as_ref()? {
+            PendingSessionAutoStartAgent::AwaitingWorkspace(_) => None,
+            PendingSessionAutoStartAgent::AwaitingShell { deadline, .. } => Some(*deadline),
+        }
+    }
+
+    pub(crate) fn try_start_session_auto_start_agent(&mut self, now: Instant) -> bool {
+        let Some(PendingSessionAutoStartAgent::AwaitingShell {
+            kind,
+            pane_id,
+            deadline,
+        }) = self.pending_session_auto_start_agent.as_ref()
+        else {
+            return false;
+        };
+        let kind = *kind;
+        let pane_id = pane_id.clone();
+        let deadline = *deadline;
+        let label = crate::detect::agent_label(kind);
+
+        if now >= deadline {
+            self.pending_session_auto_start_agent = None;
+            tracing::warn!(
+                agent = label,
+                pane_id,
+                "timed out waiting for the new session shell before agent auto-start"
+            );
+            return false;
+        }
+
+        let Some((ws_idx, internal_pane_id)) = self.parse_current_public_pane_id(&pane_id) else {
+            self.pending_session_auto_start_agent = None;
+            tracing::warn!(
+                agent = label,
+                pane_id,
+                "new session agent auto-start pane is no longer available"
+            );
+            return false;
+        };
+        let Some(terminal_id) = self
+            .state
+            .workspaces
+            .get(ws_idx)
+            .and_then(|workspace| workspace.terminal_id(internal_pane_id))
+            .cloned()
+        else {
+            self.pending_session_auto_start_agent = None;
+            tracing::warn!(
+                agent = label,
+                pane_id,
+                "new session agent auto-start pane has no terminal"
+            );
+            return false;
+        };
+        let Some(runtime) = self.terminal_runtimes.get(&terminal_id) else {
+            self.pending_session_auto_start_agent = None;
+            tracing::warn!(
+                agent = label,
+                pane_id,
+                "new session agent auto-start pane has no live terminal"
+            );
+            return false;
+        };
+        let Some(shell_name) = available_shell_name(runtime) else {
+            return false;
+        };
+        if !crate::platform::initial_pane_shell_ready_for_input(
+            &shell_name,
+            runtime.content_seq() > 0,
+            runtime.has_reported_cwd(),
+        ) {
+            return false;
+        }
+
+        self.pending_session_auto_start_agent = None;
+        let params = AgentStartParams {
+            name: label.to_string(),
+            kind: label.to_string(),
+            pane_id,
+            args: Vec::new(),
+            timeout_ms: None,
+        };
+
+        match self.start_agent(params) {
+            Ok((agent, _)) => {
+                tracing::info!(agent = label, pane_id = %agent.pane_id, "started configured agent in new session");
+                true
+            }
+            Err(err) => {
+                let error = self.agent_start_error_body(err);
+                tracing::warn!(
+                    agent = label,
+                    code = error.code,
+                    message = error.message,
+                    "failed to start configured agent in new session"
+                );
+                false
+            }
+        }
+    }
